# 服务器配置
NODE_ENV=production
PORT=3000

# 允许的跨域来源，逗号分隔；不设则只放行同源
CORS_ALLOWED_ORIGINS=https://your-domain.com

# MongoDB 配置
MONGODB_URI=mongodb://localhost:27017/fortune_miniprogram

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
# 必填：换成足够长的随机串，留着占位值起不来服务
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# 微信小程序配置
# 生产必填，两项都要。缺一项或还是占位值时，NODE_ENV=production 下 /api/user/login
# 直接返回 503，不会降级成 mock 登录 —— 降级会按一次性 code 派生 openid，
# 每次冷启动都新建一个用户，用户会发现自己的生辰、历史、神兽全没了。
WECHAT_APP_ID=your_app_id
WECHAT_APP_SECRET=your_app_secret

# 唯一的显式逃生门：生产环境确实要用 mock 登录时才设 true（会换身份，正常别开）
ALLOW_MOCK_LOGIN=false

# ── 每日运势订阅消息（微信「服务通知」）───────────────────────────────
# 推送要真的发得出去，下面四项必须齐全，缺一项都是「开关能开，就是收不到」：
#   1) WECHAT_APP_ID + WECHAT_APP_SECRET（上面两项，用来取 access_token）
#   2) WECHAT_TPL_DAILY_FORTUNE      模板 ID
#   3) WECHAT_TPL_DAILY_FORTUNE_FIELDS 字段映射
#   4) ENABLE_SCHEDULER=true         定时任务（见下方）
# 启动时会逐项检查并把缺的那一项直接点名，看服务日志的 [启动检查] 即可。
#
# 模板 ID：留空则整个推送功能关闭（GET /api/config 的 push.enabled 为 false，
# 小程序端开关置灰并说明原因，也不会去弹微信授权窗——那一次授权会被白烧掉）
WECHAT_TPL_DAILY_FORTUNE=
#
# 字段映射：格式「微信字段名:内容键」，逗号分隔。必须和你在微信公众平台
# 那个模板的参数列表**完全一致**——多一个、少一个、类型不符，微信按 47003 整条拒收。
# 微信字段类型限制（这就是 47003 的由来）：
#   thing  ≤20 字符 | phrase ≤5 个汉字 | character_string ≤32 且只收数字/字母/符号
#   number 纯数字   | date   YYYY-MM-DD | time ≤24（支持带年月日）| amount ≤11 | symbol ≤5
# 字段名一律照模板详情页的「详细内容」抄，那里会原样写出 {{thing1.DATA}} 这种名字。
# 千万别按语义猜：本项目在用的模板里「日期」被声明成 time3 而不是 date3，猜错就是 47003。
# 可用内容键：date score level rating summary brief overall yi ji yiji career wealth
#             love health luckyNumber luckyColor dayElement
# 内容键与字段类型不匹配（比如把 score 映射进只收汉字的 phrase）会在启动时直接报错。
# thing 的 20 字符是硬上限，内容要为它专门挑：summary 是一句长话，进 thing 会被截成
# 「79分 今日金气适中，工作顺利，人际关…」，结论一个字都没露出来；brief 是
# 「分数 + 最该做的一件事 + 最该避的一件事」= 79分 宜聚餐会友 忌独自决断（15 字符，不截断）。
# 例（本项目在用的「今日运势提醒」模板，参数就是 thing1 / thing2 / time3）：
# WECHAT_TPL_DAILY_FORTUNE_FIELDS=thing1:level,thing2:brief,time3:date
WECHAT_TPL_DAILY_FORTUNE_FIELDS=

# 管理员白名单，逗号分隔。不填则无人可见「简洁模式」开关与后台能力
# 手机号写法随意，+86、空格、横线都能识别
ADMIN_PHONES=
ADMIN_USER_IDS=

# 本地联调用：NODE_ENV=development 或 AppID/AppSecret 还是占位值时，
# 登录与绑定手机号会走 mock，绑定出来的号码就是这个。
# 想在本地试「简洁模式」开关，把它和上面的 ADMIN_PHONES 填成同一个号。
MOCK_BIND_PHONE=13580006666

# 简洁模式（小程序端叫「简洁模式」）：开启后首页只放出星座能量与空间美学。
# 注意只有显式写 false 才关闭，其余任何值（含留空）都按开启处理，送审安全优先。
# 数据库里 configs.auditMode 一经管理员切换即以库为准，这里只是兜底。
AUDIT_MODE=false

# 定时任务：不写 true 就不注册每日推送与订阅过期检查。
# 推送固定在北京时间 08:30（代码里显式指定 tz=Asia/Shanghai，不受容器 TZ 影响）。
# PM2 cluster 模式下只有 worker #0 会注册；多机部署再叠一把 Redis 日锁，只有一台真的发。
# 不开这一项时，管理员仍可手动触发：POST /api/push/trigger-daily
ENABLE_SCHEDULER=true

# AI服务配置（可选，留占位值则 AI 相关接口直接报错而不是空跑）
AI_API_KEY=your_ai_api_key
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-3.5-turbo
# 面相手相用的视觉模型；模型不支持图片时后端会退回文本特征模式
AI_VISION_MODEL=

# Langfuse 链路追踪（可选，两个密钥都留空则自动关闭）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
