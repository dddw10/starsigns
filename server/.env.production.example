NODE_ENV=production
PORT=3000
BASE_URL=http://SERVER_IP:3000

# 用户名/密码要和下面 MONGO_ROOT_USERNAME、MONGO_ROOT_PASSWORD 对上，authSource 固定 admin
MONGODB_URI=mongodb://fortune:replace_with_mongo_password@mongo:27017/fortune_miniprogram?authSource=admin

# docker-compose.prod.yml 里 mongo 用 --auth 启动，这两个值必填（没填 compose 会直接报错退出）
# 注意：MONGO_INITDB_ROOT_* 只在数据卷第一次初始化时创建账号。
# 如果 mongo-data 卷里已经有数据（老机器就是这种情况），得先手工建账号再开 --auth：
#   docker compose -f docker-compose.prod.yml exec mongo mongosh admin \
#     --eval 'db.createUser({user:"fortune",pwd:"上面那个密码",roles:[{role:"root",db:"admin"}]})'
MONGO_ROOT_USERNAME=fortune
MONGO_ROOT_PASSWORD=replace_with_mongo_password

REDIS_HOST=redis
REDIS_PORT=6379
# 必填：compose 会用它给 redis 加 --requirepass，留空会导致 compose 报错退出
REDIS_PASSWORD=replace_with_redis_password
REDIS_DB=0

# 必须换成 64 位随机串，用 `openssl rand -hex 32` 生成。
# 保留占位值服务会拒绝启动；换掉之后所有已签发的 token 立即失效（用户会自动重新登录）
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# 管理员白名单。ADMIN_PHONES 填已绑定的手机号（逗号分隔），
# ADMIN_USER_IDS 填 Mongo 用户 _id（逗号分隔）；命中任意一条即为管理员，
# 可以在「我的」页看到简洁模式开关和反馈处理入口
ADMIN_PHONES=
ADMIN_USER_IDS=

CORS_ALLOWED_ORIGINS=https://starsigns.online

# 定时任务：不写 true 就不注册每日推送与订阅过期检查（以前这里是 false，
# 照着这份模板部署的结果就是「界面能开、永远收不到」）。
# 推送固定北京时间 08:30，代码里显式指定 tz=Asia/Shanghai，不受容器 TZ 影响。
# PM2 cluster 只有 worker #0 注册；多机部署再叠一把 Redis 日锁，只有一台真的发。
ENABLE_SCHEDULER=true

# 登录凭证：两项都必填，缺一项或留占位值，小程序登录接口一律返回 503。
# 这里绝不会降级成 mock 登录 —— mock 的 openid 由一次性 code 派生，
# 每次冷启动都是一个新用户，线上表现就是「用户数据全没了」。
# AppSecret 在微信公众平台「开发管理 → 开发设置」里重置获取，只显示一次。
WECHAT_APP_ID=wx16d4280dedb699ee
WECHAT_APP_SECRET=your_app_secret

# 唯一的显式逃生门。留 false；设成 true 等于允许线上换用户身份
ALLOW_MOCK_LOGIN=false

# ── 每日运势订阅消息（微信「服务通知」）───────────────────────────────
# 推送要真的发得出去，四项必须齐全，缺一项都是「开关能开，就是收不到」：
#   1) WECHAT_APP_ID + WECHAT_APP_SECRET（上面两项，用来取 access_token）
#   2) WECHAT_TPL_DAILY_FORTUNE        模板 ID
#   3) WECHAT_TPL_DAILY_FORTUNE_FIELDS 字段映射
#   4) ENABLE_SCHEDULER=true           定时任务（见上方）
# 启动时会逐项检查并把缺的那一项点名，部署后看服务日志的 [启动检查]。
#
# 模板 ID：在微信公众平台「订阅消息 → 我的模板」里选一个类目模板后拿到。
# 留空则推送整体关闭：GET /api/config 的 push.enabled 为 false，
# 小程序端开关置灰并说明原因，也不会去弹微信授权窗（那一次授权会被白烧掉）。
WECHAT_TPL_DAILY_FORTUNE=
#
# 字段映射：格式「微信字段名:内容键」，逗号分隔，必须和该模板的参数列表**完全一致**。
# 多一个、少一个、类型不符，微信按 47003 整条拒收（服务日志会把当前声明打出来对账）。
# 微信字段类型限制：
#   thing  ≤20 字符 | phrase ≤5 个汉字 | character_string ≤32 且只收数字/字母/符号
#   number 纯数字   | date   YYYY-MM-DD | time ≤24（支持带年月日）| amount ≤11 | symbol ≤5
# 字段名一律照模板详情页的「详细内容」抄，那里会原样写出 {{thing1.DATA}} 这种名字。
# 千万别按语义猜：本项目在用的模板里「日期」被声明成 time3 而不是 date3，猜错就是 47003。
# 可用内容键：date score level rating summary brief overall yi ji yiji career wealth
#             love health luckyNumber luckyColor dayElement
# thing 的 20 字符是硬上限，内容要为它专门挑：summary 是一句长话，进 thing 会被截成
# 「79分 今日金气适中，工作顺利，人际关…」，结论一个字都没露出来；brief 是
# 「分数 + 最该做的一件事 + 最该避的一件事」= 79分 宜聚餐会友 忌独自决断（15 字符，不截断）。
# 例（本项目在用的「今日运势提醒」模板，参数就是 thing1 / thing2 / time3）：
# WECHAT_TPL_DAILY_FORTUNE_FIELDS=thing1:level,thing2:brief,time3:date
WECHAT_TPL_DAILY_FORTUNE_FIELDS=

AI_API_KEY=your_ai_api_key
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-3.5-turbo
